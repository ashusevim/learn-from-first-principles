---
import Base from '../layouts/Base.astro';
import { CHAPTERS, PARTS } from '../lib/chapters';

const writtenCount = CHAPTERS.filter((c) => c.written).length;
---
<Base>
  <div class="narrow">
  <section class="hero">
    <p class="tagline">$ observe --everything<span class="cursor">▊</span></p>
    <h1>Observability, from the <em>event</em> up.</h1>
    <p class="sub">
      Logs, metrics, traces — three data types answering three questions: what
      happened, how much, and where did the time go. This course builds all three
      from scratch, then debugs an incident through the telemetry you instrumented.
    </p>
    <a class="cta" href="/chapters/01-what-is-observability/">Start Chapter 1 →</a>
  </section>

  <h2 class="section-title" id="how">How this works</h2>
  <p class="section-sub">Every chapter follows the same promise:</p>
  <div class="method-grid">
    <div class="method-card">
      <h3><span>01</span>Start below the abstraction</h3>
      <p>Before "install Grafana", we answer "what is a metric, physically?"</p>
    </div>
    <div class="method-card">
      <h3><span>02</span>Nothing is magic</h3>
      <p>Structured logs, histograms, spans — data structures you can build.</p>
    </div>
    <div class="method-card">
      <h3><span>03</span>Instrument for real</h3>
      <p>The three pillars on one code path, correlated by ids, costed.</p>
    </div>
    <div class="method-card">
      <h3><span>04</span>Debug through the telemetry</h3>
      <p>The finale: an incident injected, found, and diagnosed through your tools.</p>
    </div>
  </div>

  <h2 class="section-title" id="chapters">Chapters</h2>
  <p class="section-sub">
    {writtenCount} of {CHAPTERS.length} chapters fully written{writtenCount === CHAPTERS.length ? ' — every chapter, start to finish.' : ' — the rest are outlined and on the way.'}
  </p>
  {PARTS.map((part) => (
    <div>
      <p class="part-label">{part}</p>
      <div class="chapter-grid">
        {CHAPTERS.filter((c) => c.part === part).map((c) => (
          <a class="chapter-card" href={`/chapters/${c.slug}/`}>
            <span class="num">{String(c.order).padStart(2, '0')}</span>
            <span class="body">
              <span class="t">{c.title}</span>
              <span class="b">{c.blurb}</span>
            </span>
            <span class="status dim">{c.written ? '✅' : '📝'}</span>
          </a>
        ))}
      </div>
    </div>
  ))}
  </div>
</Base>
