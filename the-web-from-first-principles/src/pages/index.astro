---
import Base from '../layouts/Base.astro';
import { CHAPTERS, PARTS } from '../lib/chapters';

const writtenCount = CHAPTERS.filter((c) => c.written).length;
---
<Base>
  <div class="narrow">
  <section class="hero">
    <p class="tagline">$ render --everything<span class="cursor">▊</span></p>
    <h1>The web, from the <em>packet</em> to the <em>pixel</em>.</h1>
    <p class="sub">
      You load pages every day and never see the machine: DNS lookups, handshakes, parse
      trees, style cascades, layout, paint. This course traces one page load byte-by-byte
      — then builds a mini browser, and the web becomes a machine you've held.
    </p>
    <a class="cta" href="/chapters/01-one-page-load-traced/">Start Chapter 1 →</a>
  </section>

  <h2 class="section-title" id="how">How this works</h2>
  <p class="section-sub">Every chapter follows the same promise:</p>
  <div class="method-grid">
    <div class="method-card">
      <h3><span>01</span>Start below the abstraction</h3>
      <p>Before "optimize your site", we answer "what happens between Enter and pixels?"</p>
    </div>
    <div class="method-card">
      <h3><span>02</span>Nothing is magic</h3>
      <p>Every hop is measurable — devtools, curl timings, tcpdump, strace.</p>
    </div>
    <div class="method-card">
      <h3><span>03</span>Build a toy version</h3>
      <p>A tokenizer, a specificity resolver, an event-loop tracer, a mini browser.</p>
    </div>
    <div class="method-card">
      <h3><span>04</span>The standards become readable</h3>
      <p>After building, the HTML/CSS/fetch specs read like documentation of your code.</p>
    </div>
  </div>

  <h2 class="section-title" id="chapters">Chapters</h2>
  <p class="section-sub">
    {writtenCount} of {CHAPTERS.length} chapters fully written{writtenCount === CHAPTERS.length ? ' — every chapter, start to finish.' : ' — the rest are outlined and on the way.'}
  </p>
  {PARTS.map((part) => (
    <div>
      <p class="part-label">{part}</p>
      <div class="chapter-grid">
        {CHAPTERS.filter((c) => c.part === part).map((c) => (
          <a class="chapter-card" href={`/chapters/${c.slug}/`}>
            <span class="num">{String(c.order).padStart(2, '0')}</span>
            <span class="body">
              <span class="t">{c.title}</span>
              <span class="b">{c.blurb}</span>
            </span>
            <span class="status dim">{c.written ? '✅' : '📝'}</span>
          </a>
        ))}
      </div>
    </div>
  ))}
  </div>
</Base>
